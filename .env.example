# ==============================================================================
# DNAPostIt Environment Variables
# ==============================================================================

# Dominio Server Dedicato & Caddy SSL
APP_DOMAIN=social.tuodominio.it
ACME_EMAIL=admin@tuodominio.it

# Database PostgreSQL
DB_USER=dnapostit
DB_PASSWORD=genera_una_password_complessa_postgres_2026
DB_NAME=dnapostit_db

# Redis & BullMQ
REDIS_PASSWORD=genera_una_password_complessa_redis_2026

# Backend Secrets
JWT_SECRET=genera_una_chiave_segreta_jwt_molto_lunga_2026
ENCRYPTION_KEY=chiave_32_caratteri_per_cifrare_token_oauth_aes256

# ==============================================================================
# Media Storage: pCloud Drive API (Consigliato - Zero Costi)
# ==============================================================================
MEDIA_STORAGE_PROVIDER=pcloud
# Token generato dalla tua app pCloud (Console sviluppatori OAuth)
PCLOUD_ACCESS_TOKEN=il_tuo_token_oauth_pcloud
# Data Center: https://eapi.pcloud.com per server europei, https://api.pcloud.com per USA
PCLOUD_API_HOST=https://eapi.pcloud.com
# Cartella creata automaticamente nella radice del tuo pCloud
PCLOUD_FOLDER_NAME=DNAPostIt_Media

# ==============================================================================
# AWS Storage (Opzionale / Fallback)
# ==============================================================================
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# ==============================================================================
# Model Context Protocol (MCP) Server
# ==============================================================================
MCP_PORT=3001
MCP_API_KEY=mcp_secret_token_per_autenticare_gli_agenti_ai

# ==============================================================================
# 7 Social Media APIs Credentials (OAuth2 & App Secrets)
# ==============================================================================

# 1. Meta (Facebook Pages, Instagram Graph, Threads)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# 2. LinkedIn (Community Management & Share on LinkedIn)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# 3. TikTok (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# 4. Google Cloud (YouTube Data API v3 & Google Business Profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=

# Redirect Base URL (usato per i callback OAuth dei social)
OAUTH_REDIRECT_BASE=https://social.tuodominio.it/api/auth/callback
